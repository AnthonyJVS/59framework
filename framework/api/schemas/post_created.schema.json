{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PostCreated",
  "description": "Response of POST /posts: the echoed payload plus a server-assigned id.",
  "type": "object",
  "required": ["id"],
  "properties": {
    "id": { "type": "integer", "minimum": 1 },
    "userId": { "type": "integer", "minimum": 1 },
    "title": { "type": "string" },
    "body": { "type": "string" }
  }
}
