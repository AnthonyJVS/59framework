# Unified Playwright + k6 + Allure execution environment for local and CI runs.
# Keep the base image tag in sync with the playwright pin in requirements.txt;
# the explicit `playwright install` below guarantees browser/library
# compatibility even on patch drift.
FROM mcr.microsoft.com/playwright/python:v1.64.1-noble

ARG K6_VERSION=2.1.0
RUN curl -fsSL "https://github.com/grafana/k6/releases/download/v${K6_VERSION}/k6-v${K6_VERSION}-linux-amd64.tar.gz" \
      | tar -xz -C /tmp \
    && mv "/tmp/k6-v${K6_VERSION}-linux-amd64/k6" /usr/local/bin/k6 \
    && rm -rf "/tmp/k6-v${K6_VERSION}-linux-amd64" \
    && k6 version

# Allure commandline (needs a JRE) so the dashboard's Allure tab works in-container.
ARG ALLURE_VERSION=2.46.1
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-21-jre-headless \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL "https://github.com/allure-framework/allure2/releases/download/${ALLURE_VERSION}/allure-${ALLURE_VERSION}.tgz" \
      | tar -xz -C /opt \
    && ln -s "/opt/allure-${ALLURE_VERSION}/bin/allure" /usr/local/bin/allure \
    && allure --version

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && python -m playwright install --with-deps chromium firefox webkit

# .dockerignore keeps .env, .venv, .git and reports/ out of this layer.
COPY . .

# Default: run the smoke suite; override the command for other suites,
# e.g. docker compose run tests python -m pytest -m regression -n auto
CMD ["python", "-m", "pytest", "-m", "smoke", "-n", "auto"]
