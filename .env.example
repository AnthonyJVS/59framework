# Copy to .env and adjust. Values are pulled into config/environments/*.yaml
# via ${VAR:default} interpolation — see config/config_loader.py.

# Environment selection for Mode A (fixed regression/smoke/API testing).
# Overridable per-run with `pytest --env=staging`.
ENV=dev

# Explicit URL overrides. When set (or passed via --base-url / --api-base-url),
# they win over the environment config — this is the Mode B / Site Scanner channel.
TARGET_URL=
API_TARGET_URL=

# Demo-app credentials (SauceDemo defaults; replace for a real application).
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce

# Gemini API key for the Live Run tab's "Analyze with Gemini" button
# (dashboard/services/gemini_service.py). Get a free-tier key at
# https://aistudio.google.com/apikey — leave empty to keep the button disabled.
GEMINI_API_KEY=
# Optional: Gemini model to use (defaults to the one in gemini_service.py).
GEMINI_MODEL=
